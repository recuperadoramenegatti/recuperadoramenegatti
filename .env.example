# ─────────────────────────────────────────────────────────────
# Recuperadora Menegatti — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# ─────────────────────────────────────────────────────────────

# Banco de dados.
#
# Localmente (e na máquina da empresa) o padrão é um arquivo SQLite — não
# precisa mexer em nada aqui. Na Vercel, DATABASE_URL deve ser a connection
# string do Postgres (fornecida pela própria Vercel ao criar o banco pelo
# painel — veja docs/DEPLOY_VERCEL.md) e o provider é trocado automaticamente
# para "postgresql" durante o build.
#
# Para forçar um provider manualmente (ex.: testar Postgres localmente),
# defina DATABASE_PROVIDER="postgresql" ou "sqlite".
DATABASE_URL="file:./menegatti.db"
# DATABASE_PROVIDER="sqlite"

# Segredo de sessão do NextAuth.
# Gere um novo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes"
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes"

# URL pública da aplicação
NEXTAUTH_URL="http://localhost:3000"

# Chave da API da Anthropic (opcional).
# Pode também ser cadastrada pela interface em /configuracoes → aba "Integração de IA".
# A chave salva na interface tem precedência sobre esta variável.
ANTHROPIC_API_KEY=""

# Modelo usado para os insights gerenciais
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Pasta onde os backups locais são gravados (relativa à raiz do projeto)
BACKUP_DIR="backups"
