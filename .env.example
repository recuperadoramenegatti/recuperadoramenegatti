# ─────────────────────────────────────────────────────────────
# Recuperadora Menegatti — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# ─────────────────────────────────────────────────────────────

# Banco de dados local SQLite (arquivo criado dentro de prisma/)
DATABASE_URL="file:./menegatti.db"

# Segredo de sessão do NextAuth.
# Gere um novo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes"
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes"

# URL pública da aplicação
NEXTAUTH_URL="http://localhost:3000"

# Chave da API da Anthropic (opcional).
# Pode também ser cadastrada pela interface em /configuracoes → aba "Integração de IA".
# A chave salva na interface tem precedência sobre esta variável.
ANTHROPIC_API_KEY=""

# Modelo usado para os insights gerenciais
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Pasta onde os backups locais são gravados (relativa à raiz do projeto)
BACKUP_DIR="backups"
