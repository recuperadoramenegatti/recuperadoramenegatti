{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // installer/windows/build/ guarda uma CÓPIA do código-fonte, montada por
    // `git archive` na hora de gerar o instalador do Windows. Sem excluí-la, o
    // TypeScript compila o projeto duas vezes e reporta erros da cópia velha —
    // e como o `next build` roda o typecheck, uma pasta de build esquecida no
    // disco passa a QUEBRAR o build do projeto.
    "installer/windows/build"
  ]
}
